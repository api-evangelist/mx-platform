{
  "opencollection": "1.0.0",
  "info": {
    "name": "MX Platform Challenges API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Challenges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List member challenges",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mx.com/users/:user_guid/members/:member_guid/challenges",
            "params": [
              {
                "name": "member_guid",
                "value": "MBR-7c6f361b-e582-15b6-60c0-358f12466b4b",
                "type": "path",
                "description": "The unique id for a `member`."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Specify current page."
              },
              {
                "name": "records_per_page",
                "value": "10",
                "type": "query",
                "description": "Specify records per page."
              },
              {
                "name": "user_guid",
                "value": "USR-fa7537f3-48aa-a683-a02a-b18940482f54",
                "type": "path",
                "description": "The unique id for a `user`."
              }
            ]
          },
          "docs": "Use this endpoint for information on what multi-factor authentication challenges need to be answered in order to aggregate a member. If the aggregation is not challenged, i.e., the member does not have a connection status of `CHALLENGED`, then code `204 No Content` will be returned. If the aggregation has been challenged, i.e., the member does have a connection status of `CHALLENGED`, then code `200 OK` will be returned - along with the corresponding credentials."
        }
      ]
    }
  ],
  "bundled": true
}