          "name": "Request widget url",
          "request": {
            "name": "Request widget url",
            "description": {
              "content": "This endpoint allows partners to get a URL by passing the `widget_type` in the request body, as well as configuring it in several different ways. In the case of Connect, that means setting the `widget_type` to `connect_widget`. Partners may also pass an optional `Accept-Language` header as well as a number of configuration options. Note that this is a `POST` request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":user_guid",
                "widget_urls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "user_guid",
                  "description": "(Required) The unique id for a `user`."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "The desired language of the widget.",
                "key": "Accept-Language",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/vnd.mx.api.v1+json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"widget_url\": {\n    \"widget_type\": \"<string>\",\n    \"client_redirect_url\": \"<string>\",\n    \"color_scheme\": \"<string>\",\n    \"current_institution_code\": \"<string>\",\n    \"current_institution_guid\": \"<string>\",\n    \"current_member_guid\": \"<string>\",\n    \"disable_background_agg\": \"<boolean>\",\n    \"disable_institution_search\": \"<boolean>\",\n    \"include_identity\": \"<boolean>\",\n    \"include_transactions\": \"<boolean>\",\n    \"insight_guid\": \"<string>\",\n    \"is_mobile_webview\": \"<boolean>\",\n    \"microwidget_instance_id\": \"<string>\",\n    \"mode\": \"<string>\",\n    \"oauth_referral_source\": \"<string>\",\n    \"ui_message_version\": \"<integer>\",\n    \"ui_message_webview_url_scheme\": \"<string>\",\n    \"update_credentials\": \"<boolean>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
